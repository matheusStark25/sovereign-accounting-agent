# Copie para .env e preencha. NUNCA versione o .env.
# Não existe valor padrão para segredos: sem eles a API não sobe.
#
# Gerar um segredo:        python -m agente_v2.cli gerar-segredo
# Gerar a chave da governança:  python -m agente_v2.cli gerar-chave-governanca   (cole a linha inteira, em uma linha)
# Gerar as chaves do RPA:       python -m agente_v2.cli gerar-chaves-rpa --saida ./chaves

# --- Obrigatórios ---
JWT_SECRET=
AUDIT_HMAC_KEY=
GOVERNANCA_DSA_KEY=
REDIS_PASSWORD=

# --- Primeiro acesso: cria UM super_admin se ainda não houver usuários. Remova ADMIN_PASSWORD depois. ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TENANT=default

# --- IA (opcional). Sem chave o sistema funciona só com cálculos e regras. O envio de textos a provedores
#     externos também exige o consentimento registrado pelo administrador da empresa (LGPD). ---
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Webhook de resultados (opcional). Recebe o resultado de TODAS as empresas desta instalação, assinado com HMAC-SHA256
#     no cabeçalho X-Signature. Precisa de HTTPS e de um segredo com 16+ caracteres. ---
DOCUMENTOS_WEBHOOK_URL=
DOCUMENTOS_WEBHOOK_SECRET=

# --- RPA do FGTS (veja o README) ---
RPA_PQC_PUBLIC_KEY=
RPA_PQC_PRIVATE_KEY=
FGTS_CAIXA_URL=https://www.caixa.gov.br
FGTS_BROWSER_CHANNEL=
FGTS_PORTAL_CONFIG=

# --- Vault (opcional: se VAULT_ADDR existir, os segredos do Vault têm prioridade sobre este arquivo) ---
VAULT_ADDR=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_CACERT=
VAULT_SECRET_PATH=agente
VAULT_DEV_ROOT_TOKEN=

# --- Opções ---
HTTPS_ONLY=
ALLOWED_ORIGINS=
ACCESS_TOKEN_EXPIRE_MINUTES=30
GOVERNANCA_LIMITES=
RETENCAO_CONFIG=
