# ===== AMBIENTE E LOGGING =====
ENVIRONMENT=production
LOG_LEVEL=info
DEBUG=False

# ===== SERVIDOR FASTAPI =====
PORT=8000
HOST=0.0.0.0
WORKERS=4
RELOAD=False

# ===== BANCO DE DADOS =====
# PostgreSQL recomendado para produção
DATABASE_URL=postgresql://user:password@postgres:5432/contabil_agente
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600

# ===== CACHE REDIS =====
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_TIMEOUT=5

# ===== AUTENTICAÇÃO e SEGURANÇA =====
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=True

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_UPLOAD_REQUESTS_PER_MINUTE=10

# ===== INTEGRAÇÃO COM FERRAMENTAS EXTERNAS =====

# eSocial Configuration
ESOCIAL_URL=https://webservices.esocial.gov.br
ESOCIAL_ENVIRONMENT=prod
ESOCIAL_TIMEOUT=30

# FG TS Configuration
FGTS_RATE=0.08

# INSS Configuration
INSS_EMPLOYER_RATE=0.20
INSS_EMPLOYEE_RATE=0.08

# ===== PROCESSAMENTO DE ARQUIVOS =====
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_TYPES=["csv", "xlsx", "xls"]
TEMP_UPLOAD_DIR=/tmp/uploads
OUTPUT_PDF_DIR=/app/pdf_outputs

# ===== JOBS =====
JOB_STATE_DIR=/app/jobs_data
JOB_TIMEOUT_MINUTES=30
JOB_CLEANUP_HOURS=24

# ===== MONITORAMENTO =====
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090

# Alertas
ALERT_ENABLED=True
ALERT_API_DOWN_THRESHOLD_SECONDS=60

# ===== NOTIFICAÇÕES =====
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_ALERTS=#alertas-geral

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-aqui

# ===== LLM / Groq Integration =====
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile

# ===== LEGACY COMPATIBILITY =====
# Vault
VAULT_ADDR=
VAULT_TOKEN=

# Metrics
METRICS_TOKEN=changeme

# Rate limit (legacy)
RATE_LIMIT_PER_MINUTE=600

# Cleanup
RETENTION_HOURS=24

# Queue / DB
QUEUE_DIR=./.queue
JOBS_DB=./.jobs.db

# Worker / runtime
STARK_OP_WORKERS=1
ADMIN_OP_RESUME_TOKEN=change_me_resume_token

# Per-tenant API keys
API_KEY_ELITE_SENIOR=demo_key_change_me_123
API_KEY_CONTABIL_ABC=another_secret_key_456

# Secrets / encryption
SECRET_ENCRYPTION_KEY=base64_or_hex_key_for_fernet
TASK_MAX_RETRIES=3
SECURITY_MIDDLEWARE_SECRET=change_this_security_middleware_secret
TEST_USER_PASSWORD=change_this_test_password

# Webhooks / alerts
TELEGRAM_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
ADMIN_ALERT_EMAIL=alerts@example.com

# New: assinatura tool HMAC secret
ASSINATURA_SECRET_KEY=change_me_assinatura_hmac_key

# Developer utilities (LEONEL key generator)
LEONEL_MASTER_KEY=
LEONEL_ENC=
# Exemplo de arquivo .env
# Copie este arquivo para .env e configure suas credenciais

# ========================================
# API Keys
# ========================================

# Groq API Key (obrigatório)
# Obter em: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ========================================
# Flask Configuration
# ========================================

# Secret key para sessões (gere uma aleatória)
SECRET_KEY=your_secret_key_here_change_in_production

# Ambiente (development ou production)
FLASK_ENV=development

# Debug mode (True ou False)
DEBUG=True

# ========================================
# Database
# ========================================

DATABASE_PATH=db/contabil.db

# ========================================
# Security
# ========================================

# Habilitar autenticação (True ou False)
REQUIRE_AUTH=False

# JWT Secret (se usar autenticação)
JWT_SECRET=your_jwt_secret_here

# ========================================
# Rate Limiting
# ========================================

# Máximo de requisições por minuto
MAX_REQUESTS_PER_MINUTE=20

# Cooldown entre requisições (ms)
REQUEST_COOLDOWN_MS=500

# ========================================
# Storage
# ========================================

# Diretório de uploads
UPLOAD_FOLDER=uploads

# Diretório de documentos
DOCUMENTS_FOLDER=documents

# Tamanho máximo de upload (bytes)
MAX_UPLOAD_SIZE=10485760

# ========================================
# Logging
# ========================================

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Diretório de logs
LOG_FOLDER=logs

# ========================================
# Optional: Cloud Storage (S3)
# ========================================

# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# S3_BUCKET_NAME=your_bucket_name
# S3_REGION=us-east-1

# ========================================
# Optional: Email Notifications
# ========================================

# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=noreply@contabil-agente.com
