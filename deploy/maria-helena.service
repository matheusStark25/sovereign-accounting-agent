# Exemplo de unidade systemd (Linux, sem Docker). Ajuste caminhos e usuário.
[Unit]
Description=Sovereign Accounting Agent (API)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
User=agente
Group=agente
WorkingDirectory=/opt/sovereign-accounting-agent
EnvironmentFile=/etc/sovereign-accounting-agent.env
ExecStart=/opt/sovereign-accounting-agent/.venv/bin/uvicorn agente_v2.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sovereign-accounting-agent

[Install]
WantedBy=multi-user.target
