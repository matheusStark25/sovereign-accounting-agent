# ============================================================================
# CONFIGURAÇÕES DE SEGURANÇA - Sistema Contábil Maria Helena
# ============================================================================
# 
# Este arquivo contém variáveis de ambiente para a camada de segurança.
# NUNCA commite o arquivo .env real com valores de produção!
#
# Para usar:
# 1. Copie este arquivo para .env.security
# 2. Gere chaves fortes (veja instruções abaixo)
# 3. Configure as variáveis com valores reais
# ============================================================================

# ----------------------------------------------------------------------------
# CHAVES DE CRIPTOGRAFIA (AES-256)
# ----------------------------------------------------------------------------
# Gere chaves fortes com:
# python -c "import secrets; print(secrets.token_hex(32))"
#
# IMPORTANTE: Use chaves diferentes para cada ambiente (dev/staging/prod)
# IMPORTANTE: Nunca compartilhe ou versione estas chaves!

# Chave atual de criptografia (obrigatória, mínimo 32 caracteres)
ENCRYPTION_KEY_CURRENT=your-super-secret-encryption-key-here-minimum-32-chars

# Versão da chave de criptografia (incrementar a cada rotação)
ENCRYPTION_KEY_VERSION=1

# Chaves antigas (para rotação sem downtime)
# Mantenha por 90 dias após rotação para descriptografar dados antigos
ENCRYPTION_KEY_V1=
ENCRYPTION_KEY_V2=
ENCRYPTION_KEY_V3=
ENCRYPTION_KEY_V4=

# ----------------------------------------------------------------------------
# CHAVES HMAC (Assinatura de Audit Logs)
# ----------------------------------------------------------------------------
# Gere chaves fortes com:
# python -c "import secrets; print(secrets.token_hex(32))"

# Chave HMAC atual (obrigatória, mínimo 32 caracteres)
HMAC_SECRET_KEY=your-super-secret-hmac-key-here-minimum-32-chars

# Versão da chave HMAC
HMAC_KEY_VERSION=1

# ----------------------------------------------------------------------------
# CREDENCIAIS DE BANCO DE DADOS (Multi-Tenant)
# ----------------------------------------------------------------------------

# Banco principal
DB_PASSWORD=your-database-password-here

# Bancos por tenant (opcional, para isolamento total)
DB_PASSWORD_TENANT_MASTER=
DB_PASSWORD_TENANT_BACKUP=

# ----------------------------------------------------------------------------
# API KEYS DE SERVIÇOS EXTERNOS
# ----------------------------------------------------------------------------

# AWS (se usar S3 para documentos)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure (se usar Azure Storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_KEY=

# OpenAI / Groq (para IA)
OPENAI_API_KEY=
GROQ_API_KEY=

# ----------------------------------------------------------------------------
# CONFIGURAÇÕES DE SEGURANÇA
# ----------------------------------------------------------------------------

# Ambiente (development, staging, production)
ENVIRONMENT=development

# Habilitar modo debug (NUNCA em produção!)
DEBUG=false

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Habilitar auditoria detalhada
AUDIT_ENABLED=true

# Diretório base de logs de auditoria
AUDIT_LOG_DIR=logs/audit

# Dias de retenção de logs de auditoria
AUDIT_RETENTION_DAYS=365

# ----------------------------------------------------------------------------
# RBAC & SEGURANÇA
# ----------------------------------------------------------------------------

# Tempo de expiração de cache de permissões (segundos)
PERMISSION_CACHE_TTL=300

# Máximo de tentativas de login falhadas
MAX_FAILED_LOGIN_ATTEMPTS=5

# Tempo de bloqueio após tentativas falhadas (segundos)
LOCKOUT_DURATION=900

# ----------------------------------------------------------------------------
# CRIPTOGRAFIA & PERFORMANCE
# ----------------------------------------------------------------------------

# Iterações PBKDF2 (padrão OWASP: 600.000)
PBKDF2_ITERATIONS=600000

# Tamanho do cache de secrets (MB)
VAULT_CACHE_SIZE_MB=10

# TTL do cache de secrets (segundos)
VAULT_CACHE_TTL=3600

# ----------------------------------------------------------------------------
# LGPD / GDPR
# ----------------------------------------------------------------------------

# Habilitar proteção PII automática
PII_PROTECTION_ENABLED=true

# Política padrão de retenção de dados (dias)
DEFAULT_RETENTION_DAYS=1825

# Consentimento obrigatório para coleta de PII
REQUIRE_CONSENT=true

# ----------------------------------------------------------------------------
# MONITORAMENTO & ALERTAS
# ----------------------------------------------------------------------------

# Webhook para alertas de segurança
SECURITY_ALERT_WEBHOOK=

# Email para notificações críticas
SECURITY_ALERT_EMAIL=security@example.com

# Habilitar métricas de segurança
SECURITY_METRICS_ENABLED=true

# ----------------------------------------------------------------------------
# ROTAÇÃO DE CHAVES
# ----------------------------------------------------------------------------

# Intervalo de rotação de chaves (dias)
KEY_ROTATION_INTERVAL_DAYS=90

# Próxima data de rotação (YYYY-MM-DD)
NEXT_KEY_ROTATION_DATE=

# Notificar X dias antes da rotação
KEY_ROTATION_NOTIFICATION_DAYS=7

# ============================================================================
# INSTRUÇÕES DE USO
# ============================================================================
#
# 1. GERAR CHAVES FORTES:
#    python -c "import secrets; print('ENCRYPTION_KEY_CURRENT=' + secrets.token_hex(32))"
#    python -c "import secrets; print('HMAC_SECRET_KEY=' + secrets.token_hex(32))"
#
# 2. CONFIGURAR .env.security:
#    cp .env.security.example .env.security
#    # Edite .env.security com as chaves geradas
#
# 3. CARREGAR VARIÁVEIS (Linux/Mac):
#    export $(cat .env.security | xargs)
#
# 4. CARREGAR VARIÁVEIS (Windows PowerShell):
#    Get-Content .env.security | ForEach-Object {
#        if ($_ -match '^([^=]+)=(.*)$') {
#            [Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process')
#        }
#    }
#
# 5. VALIDAR CONFIGURAÇÃO:
#    python -c "from contabil_agente.security import VaultManager; VaultManager().validate_secrets()"
#
# ============================================================================
# SEGURANÇA EM PRODUÇÃO
# ============================================================================
#
# - Use um gerenciador de secrets real (AWS Secrets Manager, Azure Key Vault)
# - Configure rotação automática de chaves
# - Monitore acessos com SIEM
# - Configure backups criptografados
# - Implemente 2FA para operadores
# - Audite logs regularmente
#
# ============================================================================
