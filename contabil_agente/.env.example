# Configurações do Servidor Rogio Pro
# Copie este arquivo para .env e preencha com suas configurações

# Chave da API Groq (obrigatório)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui

# Porta do servidor (padrão: 5000)
PORT=5000

# Modo debug (True ou False)
FLASK_DEBUG=False

# Configurações opcionais

# Limite de upload (em MB)
MAX_UPLOAD_SIZE=16

# Secret key para sessões
SECRET_KEY=change-this-to-a-random-secret-key

# Timeout para requests (segundos)
REQUEST_TIMEOUT=60

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
