# Configuração de Produção Multi-Tenant
# IMPORTANTE: Não commitar este arquivo com valores reais!

# Porta do servidor
PORT=5000

# Modo debug (SEMPRE False em produção)
FLASK_DEBUG=False

# Log level (INFO para produção, DEBUG para troubleshooting)
LOG_LEVEL=INFO

# === GROQ API KEY (DEFAULT - pode ser sobrescrita por empresa) ===
GROQ_API_KEY=sua_chave_groq_aqui

# === API KEYS POR EMPRESA (15 empresas) ===
# Gere keys únicas e seguras para cada empresa
API_KEY_ELITE_SENIOR=gere_key_aleatoria_aqui_001
API_KEY_CONTABIL_ABC=gere_key_aleatoria_aqui_002
API_KEY_FISCAL_PRO=gere_key_aleatoria_aqui_003
API_KEY_EMPRESA_04=gere_key_aleatoria_aqui_004
API_KEY_EMPRESA_05=gere_key_aleatoria_aqui_005
API_KEY_EMPRESA_06=gere_key_aleatoria_aqui_006
API_KEY_EMPRESA_07=gere_key_aleatoria_aqui_007
API_KEY_EMPRESA_08=gere_key_aleatoria_aqui_008
API_KEY_EMPRESA_09=gere_key_aleatoria_aqui_009
API_KEY_EMPRESA_10=gere_key_aleatoria_aqui_010
API_KEY_EMPRESA_11=gere_key_aleatoria_aqui_011
API_KEY_EMPRESA_12=gere_key_aleatoria_aqui_012
API_KEY_EMPRESA_13=gere_key_aleatoria_aqui_013
API_KEY_EMPRESA_14=gere_key_aleatoria_aqui_014
API_KEY_EMPRESA_15=gere_key_aleatoria_aqui_015

# === CONFIGURAÇÕES DE SEGURANÇA ===
SECRET_KEY=gere_secret_key_aleatoria_aqui
REQUEST_TIMEOUT=120
MAX_UPLOAD_SIZE=16

# === CONFIGURAÇÕES DE PERFORMANCE ===
GUNICORN_WORKERS=8
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# === BACKUP ===
BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_HOUR=2  # 2 AM
