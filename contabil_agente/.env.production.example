# Configurações de ambiente para produção
# COPIE ESTE ARQUIVO PARA .env E AJUSTE OS VALORES

# Flask
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING_IN_PRODUCTION

# Server
HOST=0.0.0.0
PORT=5000
WORKERS=4

# Segurança
ALLOWED_ORIGINS=https://seudominio.com,https://app.seudominio.com
API_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET

# API Keys (uma por empresa)
# Formato: API_KEY_<EMPRESA_ID>=chave_secreta_aqui
API_KEY_EMPRESA_001=demo_key_change_me_123
API_KEY_EMPRESA_002=another_secret_key_456

# Rate Limiting
RATE_LIMIT_IP_REQUESTS=60
RATE_LIMIT_IP_WINDOW=60
RATE_LIMIT_API_REQUESTS=1000
RATE_LIMIT_API_WINDOW=3600
RATE_LIMIT_EMPRESA_REQUESTS=500
RATE_LIMIT_EMPRESA_WINDOW=3600

# Groq API
GROQ_API_KEY=your_groq_api_key_here

# Observability
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=true

# LGPD
ENABLE_PII_ANONYMIZATION=true
DATA_RETENTION_DAYS=90
CONSENT_STORAGE_PATH=data/lgpd_consents.json

# Database
DB_PATH=data/chatbot.db
COMPANY_DB_PATH=data/companies

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# Redis (opcional, para rate limiting distribuído)
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# Sentry (opcional, para error tracking)
# SENTRY_DSN=https://your_sentry_dsn_here
